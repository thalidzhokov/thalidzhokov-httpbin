FROM ubuntu:latest

LABEL name="zz-httpbin"
LABEL version="0.1"
LABEL description="Актуальная версия контейнера для httpbin"
LABEL maintainer="Albert Thalidzhokov <thalidzhokov@gmail.com>"

ENV DEBIAN_FRONTEND=noninteractive

# Далее докерфайл для httpbin с минимальными изменениями
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

RUN apt update -y
RUN apt install python3-pip git -y 
RUN pip3 install --no-cache-dir pipenv

ADD Pipfile Pipfile.lock /httpbin/
WORKDIR /httpbin
RUN /bin/bash -c "pip install --no-cache-dir -r <(pipenv lock -r)"

ADD . /httpbin
RUN pip3 install --no-cache-dir /httpbin

EXPOSE 80

CMD ["gunicorn", "-b", "0.0.0.0:80", "httpbin:app", "-k", "gevent"]
